@page
@model IndexModel
@{
    ViewData["Title"] = "NC Opportunity Finder";
}

<div class="app">
    <header class="topbar"><div class="brand"><span class="mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 11 9-7 9 7v9a1 1 0 0 1-1-1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg></span><span>Rivera's Family Investors<small>NC Opportunity Finder</small></span></div><div class="topright"><div class="scan"><i></i><span data-copy="scan">Daily scan active · North Carolina</span><span id="lastImport"></span></div><button class="language" id="langToggle" aria-label="Change language">ES</button></div></header>
    <div class="layout">
      <aside>
        <div class="eyebrow" data-copy="flow">Opportunity flow</div>
        <button class="navbtn active" data-view="all"><span>▦</span><span data-copy="all">All postings</span> <span class="count" id="count-all">–</span></button>
        <button class="navbtn" data-view="info"><span>◌</span><span data-copy="info">Needs information</span> <span class="count" id="count-info">–</span></button>
        <button class="navbtn" data-view="compare"><span>◎</span><span data-copy="compare">Ready to compare</span> <span class="count" id="count-compare">–</span></button>
        <button class="navbtn" data-view="offer"><span>↗</span><span data-copy="offer">Offer review</span> <span class="count" id="count-offer">–</span></button>
        <div class="divider"></div><div class="eyebrow" data-copy="queue">Work queue</div>
        <button class="navbtn" id="roadmapNav"><span>⌁</span><span data-copy="roadmap">Roadmap & integration</span></button><button class="navbtn"><span>⌖</span><span data-copy="map">NC market map</span></button><button class="navbtn"><span>◒</span><span data-copy="contact">Seller contact</span></button><button class="navbtn"><span>□</span><span data-copy="visits">Site visits</span></button>
        <div class="sidebar-note"><b data-copy="how">How this works</b><span data-copy="howText">Every post is saved first. The system only moves a house forward when it has enough information.</span></div>
      </aside>
      <main>
        <div class="heading"><div><h1 id="pageTitle">All North Carolina postings</h1><p id="pageDescription">Every daily public listing found. Filter first; decide fast.</p></div><div class="controls"><select class="control" id="filterState" aria-label="State"></select><select class="control" id="filterCity" aria-label="City"></select><select class="control" id="filterSource" aria-label="Source"></select><select class="control" id="sortBy" aria-label="Sort"></select><button class="control" id="openCalc" data-copy="testBox">Test buy box</button><button class="primary" id="openScan"><span data-copy="scanButton">Search listings</span><span id="scanBadge"></span></button></div></div>
        <section class="metrics"><div class="metric"><b id="m1">–</b><span id="l1"></span></div><div class="metric"><b id="m2">–</b><span id="l2"></span></div><div class="metric"><b id="m3">–</b><span id="l3"></span></div><div class="metric"><b id="m4">–</b><span id="l4"></span></div></section>
        <div class="insight"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6M10 22h4M8.2 14.8A7 7 0 1 1 15.8 14.8c-.9.6-1.3 1.4-1.5 2.2h-4.6c-.2-.8-.6-1.6-1.5-2.2Z"/></svg><span id="insightText"><b>Do not lose a cheap house.</b> A lead stays visible even if it is missing photos, price, or an exact address.</span></div>
        <div class="workspace"><section class="board"><div class="board-head"><b id="boardTitle">Latest leads with the strongest signals</b><span id="boardHint">Click a property to open its analysis.</span></div><table class="table"><thead><tr><th data-copy="property">Property</th><th data-copy="asking">Asking</th><th data-copy="information">Information</th><th data-copy="next">Next step</th><th data-copy="score">Score</th></tr></thead><tbody id="rows"></tbody></table></section>
        <aside class="detail" id="detail"></aside></div>
        <section class="roadmap" id="roadmap"><div class="detail-label" data-copy="roadmapLabel">Roadmap & integration</div><h2 data-copy="roadmapTitle">What Oscar connects first</h2><p class="intro" data-copy="roadmapIntro">A practical MVP: capture every property post, protect the original evidence, enrich only the leads that matter, and require a human decision before outreach or an offer.</p><div class="phases"><article class="phase"><b>01</b><h3 data-copy="p1t">Capture</h3><p data-copy="p1d">Public posts enter through an authorized source. Save source link, date, images and raw text.</p></article><article class="phase"><b>02</b><h3 data-copy="p2t">Validate</h3><p data-copy="p2d">Extract address, price and seller signals. Flag missing data; never erase the original lead.</p></article><article class="phase"><b>03</b><h3 data-copy="p3t">Enrich</h3><p data-copy="p3d">Deduplicate, find comparable sales, estimate ARV and create repair ranges.</p></article><article class="phase"><b>04</b><h3 data-copy="p4t">Underwrite</h3><p data-copy="p4d">Use the 65% rule to produce a maximum offer and explain the calculation.</p></article><article class="phase"><b>05</b><h3 data-copy="p5t">Human action</h3><p data-copy="p5d">A team member chooses: request data, contact, visit, offer or discard.</p></article></div><div class="integration"><article class="card"><h3 data-copy="buildNow">Build now · MVP</h3><ul><li data-copy="now1">Property-lead record with source, date, evidence and status.</li><li data-copy="now2">Webhook/API endpoint for Oscar’s collector to send new leads.</li><li data-copy="now3">Deduplication + queue: All posts → Needs information → Ready to compare → Offer review.</li><li data-copy="now4">ARV, repairs, 65% offer calculator and full audit history.</li></ul></article><article class="card"><h3 data-copy="connect">How to connect the algorithm</h3><ul><li data-copy="connect1">Collector sends a normalized lead event to the API.</li><li data-copy="connect2">Platform returns lead ID, duplicate decision and missing fields.</li><li data-copy="connect3">Enrichment and scoring write back to the same property record.</li><li data-copy="connect4">When a seller replies, automation pauses and a human takes over.</li></ul></article></div></section>
      </main>
    </div>
  </div>
  <div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="calcTitle"><div class="modal-card"><div class="modal-top"><div><div class="detail-label" data-copy="calcLabel">Buy box calculator</div><h2 id="calcTitle" data-copy="calcTitle">Calculate a logical offer</h2><div class="sub" id="calcProperty"></div></div><button class="close" id="closeCalc" aria-label="Close calculator">×</button></div><p class="sub" data-copy="calcIntro">The system uses your 65% rule to protect the total project margin.</p><div class="calculator"><div class="field"><label for="arv">ARV</label><input id="arv" inputmode="numeric" placeholder="$0"></div><div class="field"><label for="repairs" data-copy="calcRepairs">Repairs</label><input id="repairs" inputmode="numeric" placeholder="$0"></div><div class="field"><label for="closing" data-copy="calcClosing">Closing + holding</label><input id="closing" inputmode="numeric" placeholder="$0"></div><div class="field"><label for="contingency" data-copy="calcContingency">Contingency</label><input id="contingency" inputmode="numeric" placeholder="$0"></div><div class="answer"><span data-copy="calcResult">Maximum offer</span><b id="result">$0</b><small data-copy="calcFormula">ARV × 65% − repairs − closing/holding − contingency</small></div></div><p class="calc-error" id="calcError" hidden></p><button class="action" id="saveNumbers" hidden data-copy="calcSave">Save numbers to this property</button></div></div>
  <div class="modal" id="scanModal" role="dialog" aria-modal="true" aria-labelledby="scanTitle"><div class="modal-card scan-card"><div class="modal-top"><div><div class="detail-label" data-copy="scanLabel">Apify · every source</div><h2 id="scanTitle" data-copy="scanTitle">Who is selling a house in this city?</h2></div><button class="close" id="closeScan" aria-label="Close">×</button></div><p class="sub" data-copy="scanIntro">Pick a US city. Apify searches every selected network at the same time and saves each house with price, phone, email, seller profile and photos. The same house found in two places is merged and scored so you can compare.</p><p class="calc-error" id="scanNotice" hidden></p>
    <div class="scan-row"><div class="field"><label for="scanState" data-copy="scanState">State</label><select id="scanState"></select></div><div class="field"><label for="scanCity" data-copy="scanCity">City</label><select id="scanCity"></select></div></div>
    <div class="field"><label data-copy="scanSources">Sources</label><div class="source-grid" id="scanSources"></div></div>
    <div class="field"><label for="scanKeywords" data-copy="scanKeywords">Keywords (optional)</label><textarea id="scanKeywords" rows="2" maxlength="900" placeholder="fixer upper, needs work, casa para reparar"></textarea><p class="muted-note" data-copy="scanKeywordsHint">One per line or separated by commas, up to 10. Each source searches the city with these words. Leave it empty to use the keyword guide.</p></div>
    <details class="scan-advanced"><summary data-copy="scanAdvanced">Source settings for this city</summary>
      <div class="scan-row"><div class="field"><label for="scanSlug" data-copy="scanSlug">Marketplace city code</label><input id="scanSlug" spellcheck="false"></div><div class="field"><label for="scanSite" data-copy="scanSite">Craigslist area</label><input id="scanSite" spellcheck="false"></div></div>
      <p class="muted-note" data-copy="scanSlugHint">Filled from the city name. If a source returns nothing, open facebook.com/marketplace or craigslist.org, pick the city and copy the code from the address bar.</p>
      <div class="field"><label for="scanGroups" data-copy="scanGroups">Facebook groups (one link per line)</label><textarea id="scanGroups" rows="3" spellcheck="false" placeholder="https://www.facebook.com/groups/..."></textarea></div>
    </details>
    <div class="scan-row"><div class="field"><label for="scanLimit" data-copy="scanLimitLabel">Results per source</label><input id="scanLimit" type="number" min="1" inputmode="numeric"></div><div class="scan-estimate" id="scanEstimate"></div></div>
    <p class="calc-error" id="scanError" hidden></p><button class="action" id="runScan" data-copy="scanRun">Search every source now</button><div class="divider2"></div><div class="detail-label" data-copy="scanHistory">Recent searches</div><ul class="history" id="scanList"></ul></div></div>
  <div class="toast" id="toast" aria-live="polite">Lead marked for human review.</div>

@section Scripts {
  <script src="~/js/site.js" asp-append-version="true"></script>
}
