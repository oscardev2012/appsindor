@page
@using System.Globalization
@{
    var en = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("en", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = en ? "Manuela Ruiz | Bilingual Realtor in Charlotte NC" : "Manuela Ruiz | Realtor bilingüe en Charlotte NC";
    ViewData["Description"] = en ? "Bilingual Realtor in Charlotte, NC for buyers, ITIN families, sellers, relocation, new construction and investment. Search homes and estimate your buying range." : "Realtor bilingüe en Charlotte, NC para compradores, familias con ITIN, vendedores, relocation, nueva construcción e inversión. Busca propiedades y estima tu rango de compra.";
    ViewData["PreloadHero"] = true;
    var lang = en ? "en" : "es";
}
@await Component.InvokeAsync("HubLatestPost")
@await Html.PartialAsync("~/Pages/Content/" + lang + "/home.cshtml")