@using ManuelaRuiz.Web.Services
@{
    var en = SiteLocale.IsEnglish(Context);
    var buyUrl = Questionnaire.Url(false, en);
    var sellUrl = Questionnaire.Url(true, en);
    var buyEmbed = Questionnaire.Embed(false, en);
    var sellEmbed = Questionnaire.Embed(true, en);
}
<section class="questionnairePair" id="home-search">
    <div class="questionnairePairIntro">
        <p class="eyebrow">@(en ? "01 · Start here" : "01 · Comienza aquí")</p>
        <h2>@(en ? "Tell Manuela if you want to buy or sell." : "Dile a Manuela si quieres comprar o vender.")</h2>
        <p>@(en
            ? "Both questionnaires are on this page, in this language. Answers go to Manuela. This is not a loan application and it does not pull credit."
            : "Los dos cuestionarios están en esta página, en este idioma. Las respuestas llegan a Manuela. No es una solicitud de préstamo y no revisa crédito.")</p>
    </div>
    <div class="questionnairePairGrid">
        <article id="buyer-form">
            <p class="googleFormLabel">@(en ? "Buyer questionnaire" : "Cuestionario de comprador")</p>
            <h3>@(en ? "I want to buy a home" : "Quiero comprar una casa")</h3>
            <a class="btn primary" href="@buyUrl" target="_blank" rel="noopener noreferrer">@(en ? "Open buyer questionnaire" : "Completar cuestionario de comprador")</a>
            <iframe class="googleFormFrame" title="@(en ? "Buyer questionnaire" : "Cuestionario de comprador")" src="@buyEmbed" loading="lazy"></iframe>
        </article>
        <article id="seller-form">
            <p class="googleFormLabel">@(en ? "Seller questionnaire" : "Cuestionario de vendedor")</p>
            <h3>@(en ? "I want to sell a home" : "Quiero vender una casa")</h3>
            <a class="btn primary" href="@sellUrl" target="_blank" rel="noopener noreferrer">@(en ? "Open seller questionnaire" : "Completar cuestionario de vendedor")</a>
            <iframe class="googleFormFrame" title="@(en ? "Seller questionnaire" : "Cuestionario de vendedor")" src="@sellEmbed" loading="lazy"></iframe>
        </article>
    </div>
</section>
