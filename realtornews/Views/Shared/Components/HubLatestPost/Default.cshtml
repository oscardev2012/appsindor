@model RealtorNews.Services.HubLatestPost
@{
    var hasImage = !string.IsNullOrWhiteSpace(Model.ImageUrl);
    var body = (Model.Body ?? "").Trim();
    var showMore = body.Length > 340;
}
<section class="hub-news" aria-label="Latest news">
    <div class="hub-news-inner">
        <div class="hub-news-card@(hasImage ? " has-image" : "")">
            <div class="hub-news-head">
                <span class="hub-news-badge">NEWS</span>
                <time datetime="@Model.PublishedUtc.UtcDateTime.ToString("yyyy-MM-dd")">@EasternTime.LongDate(Model.PublishedUtc)</time>
            </div>
            <div class="hub-news-body">
                @if (hasImage)
                {
                    <div class="hub-news-figure"><img src="@Model.ImageUrl" alt="" loading="lazy" /></div>
                }
                <div class="hub-news-copy">
                    <h2 class="hub-news-title">@Model.Title</h2>
                    @if (body.Length > 0)
                    {
                        <p class="hub-news-text">@body</p>
                    }
                    @if (showMore)
                    {
                        <details class="hub-news-more">
                            <summary>
                                <span class="hub-news-more-open">Read the full story</span>
                                <span class="hub-news-more-close">Show less</span>
                            </summary>
                        </details>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
