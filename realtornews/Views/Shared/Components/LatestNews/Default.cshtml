@model IReadOnlyList<NewsPost>
<div class="nav-drop">
    @if (Model.Count == 0)
    {
        <p>Aún no hay noticias publicadas. Un realtor puede crearlas desde su panel.</p>
        <a asp-controller="Account" asp-action="Login">Entrar al panel →</a>
    }
    else
    {
        @foreach (var post in Model)
        {
            <a asp-controller="News" asp-action="Details" asp-route-slug="@post.Slug">
                <strong>@post.Title</strong>
                <small>@post.RealtorName · @EasternTime.LongDate(post.PublishedUtc ?? post.CreatedUtc)</small>
            </a>
        }
        <a class="nav-drop-all" asp-controller="News" asp-action="Index">Ver todas las noticias →</a>
    }
</div>
