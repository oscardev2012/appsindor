@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Realtor Desk</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,600;6..72,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="realtor-app-page">
    <aside class="app-sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark">CR</span>
            <span><strong>Mi panel</strong><small>Charlotte network</small></span>
        </a>
        <nav>
            <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : null)" asp-controller="Studio" asp-action="Index">Dashboard</a>
            <a class="@(ViewContext.RouteData.Values["action"]?.ToString() is "Compose" or "Edit" ? "active" : null)" asp-controller="Studio" asp-action="Compose">Crear noticia</a>
            <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : null)" asp-controller="Studio" asp-action="Profile">Perfil</a>
            <a asp-controller="News" asp-action="Index">Ver noticias públicas</a>
        </nav>
        <div class="app-user">
            <span class="avatar">@(User.Identity?.Name is string name && name.Length > 0 ? name[..1].ToUpperInvariant() : "R")</span>
            <div>
                <strong>@User.Identity?.Name</strong>
                <span>Realtor</span>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit">Salir</button>
            </form>
        </div>
    </aside>
    <div class="app-main">
        @RenderBody()
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
