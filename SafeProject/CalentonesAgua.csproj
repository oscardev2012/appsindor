<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;CalentonesAgua.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Data\seo-architecture.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CalentonesAgua.Tests\**" />
    <Content Remove="CalentonesAgua.Tests\**" />
    <EmbeddedResource Remove="CalentonesAgua.Tests\**" />
    <None Remove="CalentonesAgua.Tests\**" />
    <Compile Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CalentonesAgua.Tests" />
  </ItemGroup>
</Project>
