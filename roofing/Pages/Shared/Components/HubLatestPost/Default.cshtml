@model MajesticRoofing.Updates.HubLatestPost
@{
    var es = string.Equals(ViewData["Lang"] as string, "es", StringComparison.OrdinalIgnoreCase)
        || (ViewContext.HttpContext.Request.Path.StartsWithSegments("/es"));
    var hasImage = !string.IsNullOrWhiteSpace(Model.ImageUrl);
    var culture = System.Globalization.CultureInfo.GetCultureInfo(es ? "es-ES" : "en-US");
    var body = (Model.Body ?? "").Trim();
    var showMore = body.Length > 340;
}
<style>
.hub-news{--news-accent:#f2a63a;background:radial-gradient(1100px 380px at 12% -40%,#20456a 0%,transparent 70%),linear-gradient(180deg,#0e2138 0%,#17324d 100%);color:#fff;padding:34px 0 38px;overflow:hidden}
.hub-news *{min-width:0}
.hub-news-inner{width:min(1180px,100% - 32px);margin:auto}
.hub-news-card{position:relative;background:linear-gradient(180deg,#ffffff14,#ffffff08);border:1px solid #ffffff1f;border-radius:22px;padding:26px 28px 28px 32px;box-shadow:0 24px 60px #00000040}
.hub-news-card:before{content:"";position:absolute;left:0;top:18px;bottom:18px;width:4px;border-radius:0 4px 4px 0;background:linear-gradient(180deg,var(--news-accent),#ffffff33)}
.hub-news-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px;margin:0 0 16px;padding:0;height:auto;min-height:0;position:static;background:none;border:0;box-shadow:none}
.hub-news-badge{display:inline-flex;align-items:center;gap:8px;padding:5px 12px;border-radius:999px;background:#ffffff14;border:1px solid #ffffff26;letter-spacing:.16em;font-size:11px;font-weight:800;color:#fff}
.hub-news-badge:before{content:"";width:7px;height:7px;border-radius:50%;background:var(--news-accent)}
.hub-news-head time{font-size:12.5px;opacity:.75;letter-spacing:.04em}
.hub-news-body{display:grid;grid-template-columns:minmax(0,1fr);gap:26px;align-items:start}
.hub-news-card.has-image .hub-news-body{grid-template-columns:220px minmax(0,1fr)}
.hub-news-figure{margin:0}
.hub-news-figure img{width:220px;height:220px;object-fit:cover;border-radius:18px;border:1px solid #ffffff1f;box-shadow:0 18px 44px #00000047}
.hub-news-title{margin:0;font-size:clamp(24px,2.4vw,34px);line-height:1.16;letter-spacing:-.025em;font-weight:800;color:#fff;max-width:30ch;text-wrap:balance;overflow-wrap:anywhere;word-break:break-word;hyphens:auto}
.hub-news-text{margin:14px 0 0;font-size:16.5px;line-height:1.75;color:#fff;opacity:.9;white-space:pre-wrap;max-width:68ch;text-wrap:pretty;overflow-wrap:anywhere;word-break:break-word;hyphens:auto;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:5;overflow:hidden}
.hub-news-copy:has(.hub-news-more[open]) .hub-news-text{display:block;-webkit-line-clamp:unset;overflow:visible}
.hub-news-more{margin-top:16px}
.hub-news-more summary{display:inline-flex;align-items:center;gap:8px;cursor:pointer;list-style:none;padding:9px 16px;border-radius:999px;border:1px solid #ffffff33;background:#ffffff10;color:#fff;font-size:13.5px;font-weight:700}
.hub-news-more summary::-webkit-details-marker{display:none}
.hub-news-more summary:after{content:"";width:7px;height:7px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:translateY(-2px) rotate(45deg)}
.hub-news-more summary:hover{background:#ffffff1f;border-color:#ffffff55}
.hub-news-more[open] summary:after{transform:translateY(1px) rotate(-135deg)}
.hub-news-more-close{display:none}
.hub-news-more[open] .hub-news-more-open{display:none}
.hub-news-more[open] .hub-news-more-close{display:inline}
@@media(max-width:760px){.hub-news{padding:26px 0 28px}.hub-news-card{padding:20px 18px 22px 24px;border-radius:18px}.hub-news-card.has-image .hub-news-body{grid-template-columns:minmax(0,1fr)}.hub-news-figure img{width:100%;height:210px}.hub-news-title{max-width:none}}
</style>
<section class="hub-news" aria-label="@(es ? "Última noticia" : "Latest news")">
    <div class="hub-news-inner">
        <div class="hub-news-card@(hasImage ? " has-image" : "")">
            <div class="hub-news-head">
                <span class="hub-news-badge">@(es ? "NOTICIA" : "NEWS")</span>
                <time datetime="@Model.PublishedUtc.UtcDateTime.ToString("yyyy-MM-dd")">@Model.PublishedUtc.ToLocalTime().ToString(es ? "d 'de' MMMM, yyyy" : "MMMM d, yyyy", culture)</time>
            </div>
            <div class="hub-news-body">
                @if (hasImage)
                {
                    <div class="hub-news-figure"><img src="@Model.ImageUrl" alt="" loading="lazy" /></div>
                }
                <div class="hub-news-copy">
                    <h2 class="hub-news-title">@Model.Title</h2>
                    @if (body.Length > 0)
                    {
                        <p class="hub-news-text">@body</p>
                    }
                    @if (showMore)
                    {
                        <details class="hub-news-more">
                            <summary>
                                <span class="hub-news-more-open">@(es ? "Leer la noticia completa" : "Read the full story")</span>
                                <span class="hub-news-more-close">@(es ? "Mostrar menos" : "Show less")</span>
                            </summary>
                        </details>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
