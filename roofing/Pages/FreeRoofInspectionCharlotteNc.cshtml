@page "/free-roof-inspection-charlotte-nc"
@{
    ViewData["Lang"] = "en";
    ViewData["SeoEn"] = "/free-roof-inspection-charlotte-nc";
    ViewData["SeoEs"] = "/es/inspeccion-gratis-de-techo-charlotte-nc";
}
<main class="resource-site" lang="en">
    @await Html.PartialAsync("_SeoIntentHeader")
    <section class="resource-hero systems-hero">
        <div class="site-shell">
            <p class="eyebrow eyebrow-light">Free roof inspection Charlotte NC</p>
            <h1>Free Roof Inspection in Charlotte, NC</h1>
            <p>A no-charge inspection is an on-site look at the roof system, photos of visible conditions and a plain-language explanation of repair versus replacement. It is not an insurance approval, not a guarantee of coverage and not a same-day repair promise. Availability is confirmed by address in the Charlotte / Rock Hill service area.</p>
            <div class="hero-actions">
                <a class="button button-gold" href="#contact">Request a free inspection</a>
                <a class="button button-ghost" href="/roof-repair-charlotte-nc">Roof repair</a>
            </div>
        </div>
    </section>
    <section class="resource-body section" id="process">
        <div class="site-shell resource-sections">
            <article><span>01</span><div>
                <h2>What we look at</h2>
                <p>Shingles or metal, flashing, penetrations, ventilation, valleys, chimneys and interior stains when you show them. Storm patterns (hail, wind, tree) are recorded as facts. We do not invent damage to create a claim.</p>
            </div></article>
            <article><span>02</span><div>
                <h2>What you receive</h2>
                <p>Photos, findings and a recommended next step: monitor, repair, tarp, or replacement planning. Cost ranges stay on the <a class="official-link" href="/roof-replacement-cost-charlotte-nc">cost page</a> and homepage planner until the roof is measured.</p>
            </div></article>
        </div>
    </section>
    <section class="faq-section section" id="faq">
        <div class="site-shell faq-layout">
            <div><p class="eyebrow">FAQ</p><h2>Inspection questions</h2></div>
            <div class="faq-list">
                <details><summary>Is the roof inspection really free?<span>+</span></summary><p>The inspection visit described on this page is no charge. Tarping, repairs and replacements are separate written work.</p></details>
                <details><summary>Do I have to file a claim after the inspection?<span>+</span></summary><p>No. An inspection can be for maintenance, a leak or a storm. Filing is your decision with your carrier.</p></details>
                <details><summary>Can you inspect in Raleigh?<span>+</span></summary><p>No. Raleigh is outside the service area. Confirm Charlotte, NC or Rock Hill, SC and nearby addresses within about 90 minutes.</p></details>
            </div>
        </div>
    </section>
    @await Html.PartialAsync("_SeoIntentFooter")
</main>
